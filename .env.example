# Copia este archivo a .env y rellená los valores.
# Ver README.md -> "1. Base de datos (Postgres)" y "2. Configurar Google Cloud".

# Base de datos Postgres (Neon / Vercel Postgres / Supabase — cualquiera
# sirve, todos tienen capa gratis). DATABASE_URL = conexión con pooling
# (para la app en runtime). DIRECT_URL = conexión directa sin pooling
# (la necesita `prisma migrate`). Si tu proveedor no distingue las dos,
# poné el mismo valor en ambas.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@host/db?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3020"
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Credenciales OAuth de Google Cloud (ver README)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Clave para cifrar los access/refresh token de Gmail en la base de datos.
# Debe ser 32 bytes en base64. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANTE: si la perdés o la cambiás, los tokens ya guardados en la base
# quedan indescifrables (habría que reconectar Gmail de nuevo). Guardala
# en un lugar seguro además de en Vercel.
TOKEN_ENCRYPTION_KEY=""
